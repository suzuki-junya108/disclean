[
  {
    "id": "xcode-deriveddata",
    "title": "Xcode DerivedData",
    "titleJa": "Xcode の中間生成物 (DerivedData)",
    "tier": "A",
    "kind": "directory",
    "paths": [
      "~/Library/Developer/Xcode/DerivedData"
    ],
    "requiresQuitApps": [
      "com.apple.dt.Xcode"
    ],
    "whatIsLost": "Build products and indexes; the next build regenerates them (slower once).",
    "whatIsLostJa": "Xcode がビルドのたびに作る作業用データです。次のビルドで作り直されます（その 1 回だけ遅くなります）。書いたコードは消えません。",
    "minMacOS": "14.0"
  },
  {
    "id": "coresimulator-caches",
    "title": "CoreSimulator caches",
    "titleJa": "シミュレータのキャッシュ",
    "tier": "A",
    "kind": "directory",
    "paths": [
      "~/Library/Developer/CoreSimulator/Caches"
    ],
    "whatIsLost": "Simulator runtime caches; regenerated on next use.",
    "whatIsLostJa": "iPhone シミュレータが作った一時データです。次に起動したときに作り直されます。",
    "minMacOS": "14.0"
  },
  {
    "id": "simctl-unavailable",
    "title": "Unavailable simulators",
    "titleJa": "使えなくなったシミュレータ",
    "tier": "A",
    "kind": "command",
    "detect": {
      "executable": "/usr/bin/xcrun",
      "arguments": [
        "simctl",
        "help"
      ]
    },
    "command": {
      "executable": "/usr/bin/xcrun",
      "arguments": [
        "simctl",
        "delete",
        "unavailable"
      ]
    },
    "sizeProbe": {
      "executable": "/usr/bin/xcrun",
      "arguments": [
        "simctl",
        "list",
        "devices",
        "--json"
      ]
    },
    "whatIsLost": "Devices whose runtime the installed Xcode no longer supports.",
    "whatIsLostJa": "いまの Xcode では動かせない、古いシミュレータの端末データです。元には戻せません。",
    "timeoutSeconds": 300,
    "minMacOS": "14.0",
    "measure": {
      "kind": "simctlUnavailable",
      "command": {
        "executable": "/usr/bin/xcrun",
        "arguments": [
          "simctl",
          "list",
          "devices",
          "--json"
        ]
      }
    }
  },
  {
    "id": "swiftpm-cache",
    "title": "SwiftPM cache",
    "titleJa": "SwiftPM のキャッシュ",
    "tier": "A",
    "kind": "directory",
    "paths": [
      "~/Library/Caches/org.swift.swiftpm"
    ],
    "whatIsLost": "Cloned package checkouts; re-fetched on the next resolve.",
    "whatIsLostJa": "Swift の部品をダウンロードして貯めた控えです。次のビルドで取り直します。",
    "minMacOS": "14.0"
  },
  {
    "id": "docker-prune",
    "title": "Docker dangling data",
    "titleJa": "Docker の未使用データ",
    "tier": "B",
    "kind": "command",
    "detect": {
      "executable": "docker",
      "arguments": [
        "info"
      ]
    },
    "command": {
      "executable": "docker",
      "arguments": [
        "system",
        "prune",
        "-f"
      ]
    },
    "whatIsLost": "Stopped containers and dangling images. Named volumes are NOT touched.",
    "whatIsLostJa": "停止したままのコンテナと、どこからも使われていないイメージです。名前を付けたデータ（ボリューム）には触れません。Docker 自身が消すため、元に戻せません。",
    "timeoutSeconds": 600,
    "minMacOS": "14.0",
    "measure": {
      "kind": "dockerReclaimable",
      "command": {
        "executable": "docker",
        "arguments": [
          "system",
          "df",
          "--format",
          "{{json .}}"
        ]
      }
    }
  },
  {
    "id": "docker-builder-prune",
    "title": "Docker build cache",
    "titleJa": "Docker のビルドキャッシュ",
    "tier": "B",
    "kind": "command",
    "detect": {
      "executable": "docker",
      "arguments": [
        "info"
      ]
    },
    "command": {
      "executable": "docker",
      "arguments": [
        "builder",
        "prune",
        "-f"
      ]
    },
    "whatIsLost": "Build layer cache; the next build takes longer once.",
    "whatIsLostJa": "イメージを組み立てる途中の作業データです。次のビルドが 1 回だけ遅くなります。Docker 自身が消すため、元に戻せません。",
    "timeoutSeconds": 600,
    "minMacOS": "14.0",
    "measure": {
      "kind": "dockerReclaimable",
      "command": {
        "executable": "docker",
        "arguments": [
          "system",
          "df",
          "--format",
          "{{json .}}"
        ]
      }
    }
  }
]
