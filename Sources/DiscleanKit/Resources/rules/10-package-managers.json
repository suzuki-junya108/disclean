[
  {
    "id": "npm-cache",
    "title": "npm cache",
    "titleJa": "npm のキャッシュ",
    "tier": "A",
    "kind": "directory",
    "detect": {
      "executable": "npm",
      "arguments": [
        "--version"
      ]
    },
    "paths": [
      "~/.npm/_cacache"
    ],
    "pathsFrom": {
      "command": {
        "executable": "npm",
        "arguments": [
          "config",
          "get",
          "cache"
        ]
      },
      "subpaths": [
        "_cacache"
      ]
    },
    "whatIsLost": "Downloaded packages are re-fetched on the next install.",
    "whatIsLostJa": "JavaScript の部品をダウンロードして貯めた控えです。消しても、次に必要になったときに自動で取り直します（そのぶん初回だけ時間がかかります）。",
    "minMacOS": "14.0",
    "verifiedOn": "25F84"
  },
  {
    "id": "pnpm-store",
    "title": "pnpm store",
    "titleJa": "pnpm のストア",
    "tier": "A",
    "kind": "directory",
    "detect": {
      "executable": "pnpm",
      "arguments": [
        "--version"
      ]
    },
    "paths": [
      "~/Library/pnpm/store",
      "~/.local/share/pnpm/store"
    ],
    "pathsFrom": {
      "command": {
        "executable": "pnpm",
        "arguments": [
          "store",
          "path"
        ]
      }
    },
    "whatIsLost": "Cached packages; re-fetched when needed.",
    "whatIsLostJa": "pnpm がダウンロードした部品の置き場です。次に必要になれば取り直します。",
    "minMacOS": "14.0",
    "verifiedOn": "25F84"
  },
  {
    "id": "yarn-cache",
    "title": "Yarn cache",
    "titleJa": "Yarn のキャッシュ",
    "tier": "A",
    "kind": "directory",
    "detect": {
      "executable": "yarn",
      "arguments": [
        "--version"
      ]
    },
    "paths": [
      "~/Library/Caches/Yarn",
      "~/.yarn/berry/cache"
    ],
    "pathsFrom": {
      "command": {
        "executable": "yarn",
        "arguments": [
          "cache",
          "dir"
        ]
      }
    },
    "whatIsLost": "Downloaded packages are re-fetched on the next install.",
    "whatIsLostJa": "Yarn がダウンロードした部品の控えです。次のインストールで取り直します。",
    "minMacOS": "14.0",
    "verifiedOn": "25F84"
  },
  {
    "id": "brew-cleanup",
    "title": "Homebrew cache",
    "titleJa": "Homebrew のキャッシュ",
    "tier": "A",
    "kind": "directory",
    "detect": {
      "executable": "brew",
      "arguments": [
        "--version"
      ]
    },
    "paths": [
      "~/Library/Caches/Homebrew"
    ],
    "pathsFrom": {
      "command": {
        "executable": "brew",
        "arguments": [
          "--cache"
        ]
      }
    },
    "whatIsLost": "Downloaded bottles and outdated versions; re-downloadable.",
    "whatIsLostJa": "Homebrew がダウンロードしたインストール用ファイルと、古い版の残りです。入れたアプリ本体は消えません。",
    "minMacOS": "14.0",
    "verifiedOn": "25F84"
  },
  {
    "id": "uv-cache",
    "title": "uv cache",
    "titleJa": "uv のキャッシュ",
    "tier": "A",
    "kind": "directory",
    "detect": {
